# Plantilla sin credenciales reales. Los marcadores no habilitan servicios.
# Copiar a .env.local y completar solo en entorno local; nunca subir .env.local.

APP_ENV=local
APP_PORT=8080

MYSQL_DATABASE=traxia
MYSQL_USER=CAMBIAR_EN_LOCAL
MYSQL_PASSWORD=CAMBIAR_EN_LOCAL
MYSQL_ROOT_PASSWORD=CAMBIAR_EN_LOCAL

JWT_SIGNING_SECRET_BASE64=CAMBIAR_POR_SECRETO_BASE64_DE_AL_MENOS_32_BYTES
JWT_ISSUER=traxia-api
JWT_AUDIENCE=traxia-web
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=604800
REFRESH_COOKIE_SECURE=false
WEB_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
AUTH_RATE_LIMIT_HMAC_SECRET_BASE64=CAMBIAR_POR_OTRA_CLAVE_BASE64_ALEATORIA_DE_AL_MENOS_32_BYTES
LOGIN_LIMIT_ACCOUNT_FAILURES=5
LOGIN_LIMIT_ADDRESS_FAILURES=30
LOGIN_LIMIT_WINDOW_SECONDS=900
LOGIN_LIMIT_BLOCK_SECONDS=900
LOGIN_LIMIT_CLEANUP_DELAY_MILLIS=3600000

# Solo para el aprovisionamiento inicial con el perfil admin-bootstrap.
# Inyectar fuera del repositorio y retirar las variables tras el uso.
TRAXIA_BOOTSTRAP_ADMIN_EMAIL=CAMBIAR_EN_LOCAL
TRAXIA_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_UNICA_DE_16_A_72_BYTES

MINIO_ROOT_USER=CAMBIAR_EN_LOCAL
MINIO_ROOT_PASSWORD=CAMBIAR_EN_LOCAL
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=traxia-local

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@traxia.local
TRAXIA_REGISTRATION_ENABLED=false
TRAXIA_TEST_NOTICE_VERSION=local-testing-1
TRAXIA_WEB_BASE_URL=http://localhost:5000

# Integraciones externas deshabilitadas por defecto; no colocar claves aquí.
MAPS_PROVIDER=mock
AI_PROVIDER=mock
IDENTITY_PROVIDER=mock
OFFICIAL_REGISTRIES_PROVIDER=mock
PUSH_PROVIDER=mock
SMS_PROVIDER=mock
